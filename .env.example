# Resend API key — never commit real values; set in .env.local / Vercel
RESEND_API_KEY=re_xxxxxxxx

# Verified sender in Resend (use onboarding@resend.dev for testing,
# or a domain you verified e.g. Portfolio <hello@yourdomain.com>)
CONTACT_FROM_EMAIL=Portfolio <onboarding@resend.dev>

# Optional — defaults to siteConfig.email (manveersohalwork@gmail.com)
CONTACT_TO_EMAIL=manveersohalwork@gmail.com

# Optional — defaults to "resend". Swap later for sendgrid / postmark / ses
# once those providers are implemented in lib/email/
EMAIL_PROVIDER=resend
